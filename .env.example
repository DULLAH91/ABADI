# Hugging Face authentication
# Create a least-privilege token in your Hugging Face account.
HF_TOKEN=

# Inference Providers
# auto = Hugging Face selects a provider according to your HF settings.
HF_PROVIDER=auto
HF_TIMEOUT_SECONDS=120

# Optional model default. Prefer explicit model IDs in production jobs.
HF_DEFAULT_MODEL=

# Optional enterprise billing target.
HF_BILL_TO=
